# ==============================================================================
# 10Min Help — Environment Configuration Template
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=5001

# Persistence (MongoDB Atlas or Local MongoDB)
# For local development without an external Mongo daemon, the backend includes an embedded in-memory database fallback.
MONGODB_URI=mongodb://localhost:27017/10min_help

# Authentication Security (Cryptographically random strings in production)
JWT_ACCESS_SECRET=10min_help_super_secure_access_secret_2026_dev_key
JWT_REFRESH_SECRET=10min_help_super_secure_refresh_secret_2026_dev_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Web Clients URLs (CORS & Redirection)
CUSTOMER_WEB_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001

# Maps & Geocoding Provider (Google Maps / Mapbox / Mock)
# Options: 'mock' (default for dev), 'google', 'mapbox'
MAPS_PROVIDER=mock
MAPS_API_KEY=mock_maps_api_key_for_development

# Payment Gateway (Razorpay India / Sandbox Mock)
# Options: 'mock' (default for dev), 'razorpay'
PAYMENT_PROVIDER=mock
PAYMENT_KEY_ID=rzp_test_sampleKeyId12345
PAYMENT_KEY_SECRET=sampleSecretValueDoNotUseInProd
PAYMENT_WEBHOOK_SECRET=sampleWebhookSecretForSignatures

# SMS / OTP Provider (Fast2SMS / Twilio / Mock)
# When set to 'mock', the OTP code '123456' is accepted in development.
OTP_PROVIDER=mock
OTP_API_KEY=mock_otp_api_key

# Push Notifications (Expo Push / Mock)
PUSH_NOTIFICATION_PROVIDER=mock

# Service Dispatch Configuration
DISPATCH_SEARCH_RADIUS_KM=10
DISPATCH_OFFER_TIMEOUT_SECONDS=15
DISPATCH_MAX_RETRY_ROUNDS=3
